{
  "expo": {
    "name": "UR Shop",
    "slug": "uk-ecom",
    "scheme": "urshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/b70345c5-868e-4dce-901a-fd05810ec451"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#7C3AED"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.aryanseth9795.urshop"
    },
    "extra": {
      "eas": {
        "projectId": "b70345c5-868e-4dce-901a-fd05810ec451"
      }
    },
    "owner": "aryanseth9795",
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UR Shop uses your location only when you tap Use current location, to fill in your delivery address.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7C3AED"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED"
        }
      ],
      "./plugins/withOptionalPortraitFeature"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
