# Copy to .env and adjust. Never commit the filled-in file.

# API base URL. Defaults to production if unset.
# Point at a local backend for development, e.g.:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:5000/api/v1/user
# This replaces the old approach of editing src/api/client.ts, which meant
# every simulator run talked to production (CA-09).
EXPO_PUBLIC_API_BASE_URL=
